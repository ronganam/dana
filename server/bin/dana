#!/usr/bin/env python3
"""Dana's command line: ``bin/dana users …`` and ``bin/dana addons …`` (cli/main.py; ``--help``)."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

# Dana's own .env, and LiteLLM kept from loading any, before anything else of Dana (core/env_file.py).
from core import env_file  # noqa: E402
env_file.load()

from cli.main import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
