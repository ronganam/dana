#!/usr/bin/env bash
# Deploy a published release of Dana (docs/operations.md, "Deploying").
#
#   bin/deploy                  deploy the version in server/VERSION
#   bin/deploy <version>        deploy another version (e.g. 10.4.0)
#   bin/deploy … --wait         … and wait until Dana runs it
#
# Reads your site's deploy.env: site/deploy.env at the repository root, or
# $DANA_SITE/deploy.env (docs/site.md; DANA_DEPLOY_CONFIG names another file).
# Builds nothing: the release workflow (.github/workflows/release.yml) publishes
# "$DANA_IMAGE:<version>" (default ghcr.io/ronganam/dana) when the tag v<version> is pushed.
# This waits for that image to exist (up to DANA_IMAGE_WAIT seconds), then rolls it out:
#   - GitOps (DANA_GITOPS_REPO set): every `tag:` line of DANA_GITOPS_VALUES in that
#     repository becomes "<version>" (and a `repository: …/dana` line DANA_IMAGE, so bin/ship's
#     dev images and releases take turns; DANA_ARGO_APP=<namespace>/<app> asks ArgoCD to refresh
#     right away), and each installed add-on's worker image
#     (`image: <published image>:<tag>`) is pinned to what `dana addons workers --json`
#     says where Dana runs ($DANA_EXEC, e.g. kubectl -n dana exec deploy/dana -c dana --);
#     the commit is pushed for the GitOps tool (ArgoCD, Flux) to roll the pod. It is made in
#     a private clone (~/.cache/dana-deploy/gitops), never in your own checkout.
#   - Compose (DANA_COMPOSE_DIR set: the folder of the compose.yaml at the repository root):
#     DANA_VERSION=<version> in its .env (the image tag), each worker's <ADDON>_WORKER_TAG
#     likewise, then `docker compose pull` and `up -d`.
#   - Neither: it only says the image is ready; roll it out yourself.
# --wait (GitOps): until the pod runs that image and is ready.
set -euo pipefail
server="$(cd "$(dirname "$0")/.." && pwd)"

site="${DANA_SITE:-$(dirname "$server")/site}"
config="${DANA_DEPLOY_CONFIG:-$site/deploy.env}"
if [ ! -r "$config" ]; then
  echo "deploy: no $config (start your site from site.example/: docs/site.md)" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$config"
DANA_IMAGE="${DANA_IMAGE:-ghcr.io/ronganam/dana}"
DANA_IMAGE_WAIT="${DANA_IMAGE_WAIT:-1800}"
DANA_EXEC="${DANA_EXEC:-}"
DANA_GITOPS_REPO="${DANA_GITOPS_REPO:-}"
DANA_GITOPS_BRANCH="${DANA_GITOPS_BRANCH:-main}"
DANA_GITOPS_VALUES="${DANA_GITOPS_VALUES:-}"
DANA_COMPOSE_DIR="${DANA_COMPOSE_DIR:-}"
DANA_K8S_NAMESPACE="${DANA_K8S_NAMESPACE:-dana}"
DANA_K8S_SELECTOR="${DANA_K8S_SELECTOR:-app=dana}"
GITOPS=${XDG_CACHE_HOME:-$HOME/.cache}/dana-deploy/gitops

wait_pod=0
version=""
for arg in "$@"; do
  case "$arg" in
    --wait) wait_pod=1 ;;
    -h|--help) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "deploy: unknown option $arg" >&2; exit 2 ;;
    *) version="$arg" ;;
  esac
done
[ -n "$version" ] || version="$(tr -d '[:space:]' < "$server/VERSION")"
version="${version#v}"
if ! [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]]; then
  echo "deploy: $version is not a version (e.g. 10.4.0)" >&2
  exit 2
fi
image="$DANA_IMAGE:$version"

# The release workflow may still be building it: wait, saying so.
waited=0
until docker manifest inspect "$image" >/dev/null 2>&1; do
  if [ "$waited" -ge "$DANA_IMAGE_WAIT" ]; then
    echo "deploy: $image does not exist after ${DANA_IMAGE_WAIT}s. Was the tag v$version pushed, and did the" \
      "release workflow pass? (gh run list --workflow release.yml)" >&2
    exit 1
  fi
  [ "$waited" = 0 ] && echo "deploy: waiting for $image (the release workflow publishes it from the tag v$version) …"
  sleep 20
  waited=$((waited + 20))
done
echo "deploy: $image is published"

# The installed add-ons' workers, asked where the data lives: "name image tag" lines
# (tag "@sha256:…" for a digest).
workers=()
if [ -n "$DANA_EXEC" ]; then
  # shellcheck disable=SC2086
  listing="$($DANA_EXEC dana addons workers --json)" \
    || { echo "deploy: '$DANA_EXEC dana addons workers --json' failed" >&2; exit 1; }
  while IFS= read -r line; do
    [ -n "$line" ] && workers+=("$line")
  done < <(python3 -c 'import json, sys
for w in json.load(sys.stdin):
    print(w["name"], w["image"], w["tag"])' <<< "$listing")
  for w in "${workers[@]}"; do
    read -r name wimage tag <<< "$w"
    echo "deploy: the $name worker runs $wimage $tag (published by the add-on's repository)"
  done
else
  echo "deploy: no DANA_EXEC in $config: worker images are left as they are"
fi

if [ -n "$DANA_GITOPS_REPO" ]; then
  : "${DANA_GITOPS_VALUES:?deploy: set DANA_GITOPS_VALUES in $config}"
  app="$(basename "$(dirname "$DANA_GITOPS_VALUES")")"
  # Run from a git hook, git may export these for this repo; the GitOps repo is another one.
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_PREFIX
  if [ ! -d "$GITOPS/.git" ] || [ "$(git -C "$GITOPS" remote get-url origin)" != "$DANA_GITOPS_REPO" ]; then
    rm -rf "$GITOPS"
    mkdir -p "$(dirname "$GITOPS")"
    git clone -q "$DANA_GITOPS_REPO" "$GITOPS"
  fi
  for attempt in 1 2 3; do
    git -C "$GITOPS" fetch -q origin "$DANA_GITOPS_BRANCH"
    git -C "$GITOPS" checkout -q -B "$DANA_GITOPS_BRANCH" "origin/$DANA_GITOPS_BRANCH"
    sed -i -E -e "s/^(\s*tag:\s*).*/\1\"$version\"/" \
      -e "s#^(\s*repository:\s*)\"?[^\"[:space:]]*/dana\"?\s*\$#\1$DANA_IMAGE#" "$GITOPS/$DANA_GITOPS_VALUES"
    # Each worker's image (any key naming that repository: "<image>:<tag>" or "<image>@<digest>").
    for w in "${workers[@]}"; do
      read -r name wimage tag <<< "$w"
      ref="$wimage:$tag"; [ "${tag#@}" != "$tag" ] && ref="$wimage$tag"
      sed -i -E -e "s#(image:\s*\"?)$wimage[:@][^\"[:space:]]*#\1$ref#" "$GITOPS/$DANA_GITOPS_VALUES"
    done
    if git -C "$GITOPS" diff --quiet -- "$DANA_GITOPS_VALUES"; then
      echo "deploy: $DANA_GITOPS_VALUES already runs $version"
      break
    fi
    git -C "$GITOPS" commit -q -m "chore($app): deploy $version" -- "$DANA_GITOPS_VALUES"
    if git -C "$GITOPS" push -q origin "$DANA_GITOPS_BRANCH"; then
      echo "deploy: $DANA_GITOPS_VALUES set to $image; the GitOps tool rolls the pod"
      if [ -n "${DANA_ARGO_APP:-}" ]; then  # namespace/name: ask ArgoCD to look now, not at its next poll
        kubectl -n "${DANA_ARGO_APP%%/*}" annotate application "${DANA_ARGO_APP#*/}" \
          argocd.argoproj.io/refresh=normal --overwrite >/dev/null && echo "deploy: ArgoCD asked to refresh ${DANA_ARGO_APP#*/}"
      fi
      break
    fi
    [ "$attempt" = 3 ] && { echo "deploy: could not push the GitOps change" >&2; exit 1; }
  done
  if [ "$wait_pod" = 1 ]; then
    echo "deploy: waiting for the pod to run $image …"
    until kubectl -n "$DANA_K8S_NAMESPACE" get pod -l "$DANA_K8S_SELECTOR" \
        -o jsonpath='{range .items[*]}{.spec.containers[0].image} {.status.containerStatuses[0].ready}{"\n"}{end}' \
        | grep -qF "$image true"; do sleep 10; done
    echo "deploy: $version is running"
  fi
elif [ -n "$DANA_COMPOSE_DIR" ]; then
  envfile="$DANA_COMPOSE_DIR/.env"
  touch "$envfile"
  set_env() {  # KEY VALUE: replace its line, or add one
    if grep -qE "^$1=" "$envfile"; then sed -i -E "s#^$1=.*#$1=$2#" "$envfile"; else echo "$1=$2" >> "$envfile"; fi
  }
  set_env DANA_VERSION "$version"
  for w in "${workers[@]}"; do
    read -r name wimage tag <<< "$w"
    if [ "${tag#@}" != "$tag" ]; then
      echo "deploy: the $name worker is pinned by digest ($tag): set its image in the compose file yourself" >&2
      continue
    fi
    set_env "$(tr '[:lower:]' '[:upper:]' <<< "$name")_WORKER_TAG" "$tag"
  done
  (cd "$DANA_COMPOSE_DIR" && docker compose pull -q && docker compose up -d)
  echo "deploy: $DANA_COMPOSE_DIR runs $version"
else
  echo "deploy: $image is ready (no DANA_GITOPS_REPO or DANA_COMPOSE_DIR in $config: roll it out yourself)"
fi
