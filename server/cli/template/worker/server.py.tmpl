"""The {{name}} worker: a small HTTP server (standard library only) that Dana calls.

``GET /ping`` → ``{"message": "..."}``. Listens on ``$PORT`` (8091). Put the
work that does not belong in Dana's process here (a browser, a heavy library).
"""

import json
import os
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


class Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        if self.path != "/ping":
            self.send_error(404)
            return
        body = json.dumps({"message": "The {{name}} worker is up"}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        pass


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", int(os.getenv("PORT", "8091"))), Handler).serve_forever()
