"""The {{name}} addon: its tools (setting, facts service, model), Now card and day item{{#web}}, page and route{{/web}}{{#worker}}, worker{{/worker}}, for the users who have it only.

Run: bin/dana addons test <this addon's folder> (from Dana's server/), or
DANA_HOME=<a Dana checkout> python tests/test_{{name}}.py. Robin (the first admin)
and Gal turn it on, Maya does not. Every name and value is made up.
"""

import asyncio
import os
import sys
{{#worker}}import socket
import subprocess
{{/worker}}
import dana_harness  # first: finds Dana (DANA_HOME), a clean environment and a temporary database
dana_harness.start("{{name}}_test")
{{#web}}os.environ["API_TOKEN"] = "{{name}}-test-env-token"  # a test value: with it set, Bearer tokens decide the user
{{/web}}
{{#web}}from aiohttp import web  # noqa: E402
from aiohttp.test_utils import TestClient, TestServer  # noqa: E402

{{/web}}from core import clock, db, users  # noqa: E402

db.migrate()
users.bootstrap()

{{#web}}from core.auth import setup_auth  # noqa: E402
from core.addons.addon import get_addon  # noqa: E402
{{/web}}from core.addons import NowContext, loader, registry  # noqa: E402
from core.addons.registry import ToolNotAvailable  # noqa: E402
import fakes  # noqa: E402

failures = 0


def check(name: str, cond: object, detail: object = "") -> None:
    global failures
    print(f"[{'PASS' if cond else 'FAIL'}] {name}" + (f" — {detail}" if detail and not cond else ""))
    failures += 0 if cond else 1


ROBIN, GAL, MAYA = fakes.three_users("{{name}}", gal_settings={"greeting": "Shalom"})
LLM = fakes.FakeLLM(lambda messages, purpose: "Owls hoot at night,\nthen sleep in the light.").install()


def hook(kind: str, user: users.User):
    """This addon's hook of ``kind`` for ``user`` (None: not offered to them)."""
    return next((h for h in registry.hooks(kind, user) if h.addon == "{{name}}"), None)


async def main() -> None:
    check("loaded", "{{name}}" in loader.loaded(), loader.failed())
    check("tool: the setting's default", await registry.execute(ROBIN, "{{name}}_hello", {"who": "Noa"}) == "Hello, Noa!")
    check("tool: each user's own setting", await registry.execute(GAL, "{{name}}_hello", {"who": "Noa"}) == "Shalom, Noa!")
    try:
        await registry.execute(MAYA, "{{name}}_hello", {"who": "Noa"})
        refused = False
    except ToolNotAvailable:
        refused = True
    check("tool: refused for a user without the addon", refused and not registry.has_tool(MAYA, "{{name}}_hello"))
    check("prompt: its line only for its users",
          all(any("{{name}}_hello" in p for p in registry.prompt_parts(u, "guides")) for u in (ROBIN, GAL))
          and not any("{{name}}_hello" in p for p in registry.prompt_parts(MAYA, "guides")))

    # The facts service: a fake on this machine, reached through {{NAME}}_API_URL.
    async with fakes.FakeHTTP({"GET /facts": lambda request: (200, {"fact": f"{request.query['topic']} can fly."})}) as svc:
        os.environ["{{NAME}}_API_URL"] = svc.url
        fact = await registry.execute(ROBIN, "{{name}}_fact", {"topic": "Owls"})
        check("tool: a fact from the facts service", fact == "Owls can fly." and svc.requests[-1]["query"] == {"topic": "Owls"},
              fact)
    del os.environ["{{NAME}}_API_URL"]

    # The model: the fake answers, under the addon's purpose.
    rhyme = await registry.execute(GAL, "{{name}}_rhyme", {"word": "light"})
    check("tool: a rhyme from the model, under its purpose", rhyme.startswith("Owls hoot")
          and LLM.calls[-1]["purpose"] == "{{name}}_rhyme", (rhyme, LLM.calls))

    # The Now screen: a morning card and a day item, for its users only.
    morning = NowContext(now=clock.now().replace(hour=9, minute=0), hidden={})
    cards = hook("now_cards", ROBIN).func(ROBIN, morning)
    check("now: a morning card", [c.title for c in cards] == ["Say hello to someone today"], cards)
    check("now: no card in the afternoon", hook("now_cards", ROBIN).func(ROBIN, NowContext(
        now=clock.now().replace(hour=15, minute=0), hidden={})) == [])
    items = hook("day_items", GAL).func(GAL, morning)
    check("now: the day item at noon", [(i.title, i.at.hour) for i in items] == [("Hello hour", 12)], items)
    check("now: nothing for Maya", hook("now_cards", MAYA) is None and hook("day_items", MAYA) is None)
{{#web}}
    page = (dana_harness.ADDON / "web" / "{{name}}.js").read_text(encoding="utf-8")
    check("page: declared, its script registers with Dana.panel",
          [p.id for p in get_addon("{{name}}").web] == ["{{page}}"] and "Dana.panel(" in page)
    app = web.Application()
    setup_auth(app)
    dict(loader.apis())["{{name}}"].setup(app)
    async with TestClient(TestServer(app)) as c:
        async def get(user: users.User) -> tuple:
            r = await c.get("/api/{{name}}", headers={"Authorization": "Bearer " + users.issue_token(user.id, "t")[0]})
            return r.status, await r.json()
        check("route: each user gets their own greeting",
              await get(ROBIN) == (200, {"greeting": "Hello"}) and await get(GAL) == (200, {"greeting": "Shalom"}))
        status, body = await get(MAYA)
        check("route: a user without the addon is refused (403 not_connected)", status == 403, body)
{{/web}}{{#worker}}
    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()
    worker = subprocess.Popen([sys.executable, str(dana_harness.ADDON / "worker" / "server.py")],
                              env={**os.environ, "PORT": str(port)})
    os.environ["{{env}}"] = f"http://127.0.0.1:{port}"
    try:
        answer = ""
        for _ in range(50):  # until it listens
            try:
                answer = await registry.execute(ROBIN, "{{name}}_worker_ping", {})
                break
            except OSError:
                await asyncio.sleep(0.1)
        check("worker: the tool reaches it", answer == "The {{name}} worker is up", answer)
    finally:
        worker.terminate()
        worker.wait(10)
{{/worker}}

asyncio.run(main())
if failures:
    sys.exit(f"{failures} check(s) failed")
print("\nAll {{name}} checks passed")
