"""The ``{{name}}`` addon's manifest: everything it adds to Dana is declared on this object."""

from core.addons import Addon, Field, PromptPart, Touches{{#worker}}, Need{{/worker}}{{#web}}, Nav, Page{{/web}}{{#worker}}, Worker{{/worker}}

addon = Addon(
    "{{name}}",
    title="{{title}}",
    description="{{title}}: say what it does in one line (the Addons page shows it)",
    version="0.1.0",
    icon="sparkles",                                   # a Lucide icon name for the Addons page
    # What it adds and what to say to Dana once it's on, in plain words (the Addons page shows them).
    features=("Greets people in your words",),
    examples=("Say hello to Noa",),
    # setup=("A step done outside Dana before connecting",), when there is one (an account, a server).
    # What running it takes, shown before it is turned on: Need(kind, what, why, optional=False) with kind
    # env / account / hardware / app / region / addon, e.g. Need("account", "a weather service account", "Forecasts").
{{#worker}}    needs=(Need("env", "{{env}}", "Where Dana reaches the sidecar (default http://127.0.0.1:8091)", optional=True),),
{{/worker}}    # What it may touch beyond Dana's own data: hosts it contacts, acting for the user outside Dana (messages,
    # mail), stored credentials, other addons' data it reads. Shown before installing; growing it asks again.
    touches=Touches({{#worker}}hosts=("its sidecar ({{env}})",){{/worker}}),
    # Per-user choices (plain JSON); credentials=(Field(...),) would be stored encrypted.
    settings=(Field("greeting", "How {{name}} greets people", default="Hello", label="Greeting",
                    help="The word Dana starts a greeting with.", placeholder="Hello"),),
    # A line of the agent's instructions, only for users who turned the addon on.
    prompt_parts=(PromptPart("guides", "When the user asks to greet someone, use {{name}}_hello.", rank=90),),
{{#web}}    # A page in the web app: web/{{name}}.js and web/{{name}}.css, a button in the navigation.
    web=(Page("{{page}}", panel="{{name}}.js", style="{{name}}.css", nav=Nav("{{title}}", icon="sparkles", order=80)),),
{{/web}}{{#worker}}    # A sidecar built from worker/ (its Dockerfile); Dana reaches it at the URL in {{env}}.
    worker=Worker(port=8091, url_env="{{env}}"),
{{/worker}})
