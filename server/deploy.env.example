# bin/deploy's settings: copy to server/deploy.env (gitignored) and fill in.
# Without server/deploy.env, pushing master runs the tests and deploys nothing.

# The image Dana is pushed as (tags "<VERSION>-<commit>" and "latest").
DANA_IMAGE=registry.example.com/dana
# The bank-worker sidecar (the money kind's bank syncs). Empty: not built.
DANA_WORKER_IMAGE=registry.example.com/dana-bank-worker

# GitOps: the repository and values file whose `tag:` lines get the new release.
# Empty DANA_GITOPS_REPO: the images are pushed and you roll them out yourself.
DANA_GITOPS_REPO=
DANA_GITOPS_BRANCH=main
DANA_GITOPS_VALUES=apps/dana/values.yaml

# `bin/deploy --wait`: where the pod runs.
DANA_K8S_NAMESPACE=dana
DANA_K8S_SELECTOR=app=dana

# Plugin kinds to build into the image (folders of kinds, separated by ":"; docs/plugins.md).
DANA_IMAGE_PLUGINS=
