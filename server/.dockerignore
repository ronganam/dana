# Keep local state and secrets out of every build context (CI checks out a clean tree;
# a local `docker build .` would otherwise send these).
.git
.venv
.env
.env.*
!.env.example
**/__pycache__
**/node_modules
*.sqlite3
*.sqlite3-*
db/
recordings/
media/
uploads/
app-updates/
snapshots/
tests/local_env/.state
scratch/
