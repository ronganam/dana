# Telegram bot token (from BotFather). Optional: without it Dana runs without the
# Telegram bot (web UI and apps only).
TELEGRAM_BOT_TOKEN=

# Key that encrypts integration credentials in the database (Fernet). Required as
# soon as an integration with credentials exists or is imported from the values
# below (Home Assistant, WAHA, Google refresh token); keep it: stored credentials
# cannot be read without it. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# LLM provider keys (LiteLLM's standard names) — set the ones your models use
ANTHROPIC_API_KEY=
# Transcription (audio → text) stays on Gemini: Claude takes no audio
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Models (LiteLLM ids, provider/model) — see docs/configuration.md. Unset: MODEL / SEARCH_MODEL
# anthropic/claude-sonnet-5-5, the background jobs anthropic/claude-haiku-5-5, TRANSCRIBE_MODEL gemini/gemini-3.1-flash-lite
# MODEL=anthropic/claude-sonnet-5-5
# BACKGROUND_MODEL=anthropic/claude-haiku-5-5
# TRANSCRIBE_MODEL=gemini/gemini-3.1-flash-lite

# Minutes to suppress repeat firing of one-shot triggers (time, wake).
TRIGGER_REFIRE_COOLDOWN_MINUTES=120

# Max leave->return gap (minutes) still treated as GPS jitter.
# A return counts as genuine (and refires) only after you were
# actually seen away longer than this. Quick real returns still alert.
TRIGGER_FLAP_MINUTES=3

# Android app update hosting (android/bin/deploy-app.sh publishes APKs here)
# Bearer token required to POST /api/app/upload (publishing APKs)
APP_PUBLISH_TOKEN=choose_a_random_publish_token

# Web server / API authentication. Clients send "Authorization: Bearer <API_TOKEN>"
# (this token, which is the first user's, or a user's own from bin/users.py tokens issue);
# browsers sign in once at /login. Leave empty to disable auth (local dev only).
API_TOKEN=
# Host header values trusted without a token on /webhook/waha (in-cluster Service DNS names).
INTERNAL_HOSTS=

# Site addons kept outside this repository (docs/writing-an-addon.md): folders whose sub-packages
# are loaded as addons, separated by ":". Unset: the site's addons/. The container image loads /app/addons-site.
# DANA_ADDON_DIRS=

# The server's timezone for reminders and the agent's notion of "now" (e.g. Asia/Jerusalem).
# Falls back to the first user's Home Assistant zone, then TZ, then UTC.
TIMEZONE=

# ---------------------------------------------------------------------------------------
# READ ONCE AT FIRST START. Everything below creates the first user and their
# integrations the first time the server starts (docs/configuration.md); after that
# it is never read again and can be removed. Change users and integrations with
# bin/users.py (or PUT /api/addons/{kind}) instead.
# ---------------------------------------------------------------------------------------

# The first user: name and profile for prompts, Telegram ids and proactive chat
# OWNER_NAME=Maya Cohen
# A few sentences about you and the people you talk about (partner, family, work).
# OWNER_CONTEXT=
# he / she / they (default they); your first name in another script, for transcripts
# OWNER_PRONOUN=they
# OWNER_OTHER_NAMES=
# Find your user ID by messaging @userinfobot on Telegram; empty = the bot is public
ALLOWED_TELEGRAM_USER_IDS=
# Telegram chat for reminders, briefing, weekly review, digest
TELEGRAM_CHAT_ID=

# Home Assistant (the first user's homeassistant integration)
HOMEASSISTANT_HOST=https://your-ha-instance.domain.com/
HOMEASSISTANT_TOKEN=
PRIMARY_PERSON=person.your_name
PHONE_NOTIFY_SERVICE=mobile_app_your_phone
PHONE_INTERACTIVE_SENSOR=binary_sensor.your_phone_interactive
PHONE_BATTERY_SENSOR=sensor.your_phone_battery_level

# WAHA WhatsApp API (the first user's whatsapp integration)
WAHA_URL=https://your-waha-instance.example.com/api/
WAHA_API_KEY=
WAHA_SESSION=default
# Where inbound WhatsApp voice transcripts are sent on Telegram (/chatid in the bot). Empty = off.
WHATSAPP_VOICE_TELEGRAM_CHAT_ID=

# Also imported once if set: GOOGLE_REFRESH_TOKEN, GOOGLE_CALENDAR_ID, FRIGATE_URL,
# BRIEFING_WEATHER_ENTITY (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET stay server-wide).
