# Dana's server configuration (docs/configuration.md lists every variable).
# The minimal first run needs one value: an LLM key. Start the server and open the setup link it
# writes to its log (…/setup?code=…) to create your admin account; then pair your phone and other
# devices on the web Devices page. Everything else is optional; addons (Home Assistant, WhatsApp,
# Google, …) are connected later on the web Addons page (Settings → Addons) or with bin/dana, never
# from this file.

# --- Required ---------------------------------------------------------------------------

# LLM provider key (LiteLLM's standard names). By default every model is Claude.
ANTHROPIC_API_KEY=

# --- Optional ---------------------------------------------------------------------------

# The server's public address, as phones and QR codes should reach it (pairing, the Google
# sign-in). Unset: the address each request came to.
# PUBLIC_URL=https://dana.example.com

# Headless install only: a token of the first admin, which then is created at the first start
# from the OWNER_* values below instead of on the setup page (openssl rand -hex 32).
# API_TOKEN=
# Local development only: without API_TOKEN, a request without credentials is the first admin
# and the server listens on 127.0.0.1.
# DANA_INSECURE_DEV=1

# Transcription (audio → text: voice notes, calls) needs a model that hears audio; by default Gemini.
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Models (LiteLLM ids, provider/model). Unset: MODEL / SEARCH_MODEL anthropic/claude-sonnet-5-5,
# the background jobs anthropic/claude-haiku-5-5, TRANSCRIBE_MODEL gemini/gemini-3.1-flash-lite.
# MODEL=anthropic/claude-sonnet-5-5
# BACKGROUND_MODEL=anthropic/claude-haiku-5-5
# TRANSCRIBE_MODEL=gemini/gemini-3.1-flash-lite

# Key that encrypts addon credentials in the database (Fernet). Unset: the first start generates
# one into <data dir>/credentials.key (mode 0600) — back that file up with the database.
# Set it here (or in your secret store) to keep the key outside the data directory.
# CREDENTIALS_KEY=

# The server's timezone for reminders and "now" (e.g. Europe/Berlin). Unset: the admin's
# Home Assistant zone, then TZ, then UTC.
# TIMEZONE=

# Languages and currency for new users (each user can change theirs on the Profile page).
# DEFAULT_LANGUAGES=en
# CURRENCY=USD
# Country calling code for phone numbers typed without one (e.g. 1, 44, 972). Unset: numbers stay as given.
# DEFAULT_COUNTRY_CODE=

# Telegram bot token (from BotFather). Unset: no Telegram bot (web UI and apps only).
# TELEGRAM_BOT_TOKEN=

# WhatsApp (WAHA) webhooks: the shared secret WAHA signs each webhook with (its HMAC key,
# WHATSAPP_HOOK_HMAC_KEY on the WAHA side). Unset: incoming WhatsApp events are refused.
# WAHA_WEBHOOK_SECRET=

# Android app publishing (android/bin/deploy-app.sh): the token POST /api/app/upload requires,
# at least 24 characters (openssl rand -hex 32). Unset: publishing is disabled.
# APP_PUBLISH_TOKEN=

# Site addons kept outside this repository (docs/writing-an-addon.md), separated by ":".
# DANA_ADDON_DIRS=

# --- The first user ---------------------------------------------------------------------
# Read once, when the server creates its first user (the admin); change it later on the
# Profile page or with bin/dana users update.

# OWNER_NAME=Maya Cohen
# A few sentences about you and the people you talk about (partner, family, work).
# OWNER_CONTEXT=
# he / she / they (default they); your first name in another script, for transcripts
# OWNER_PRONOUN=they
# OWNER_OTHER_NAMES=
# Your languages (comma list, the first is the default reply language) and currency (ISO 4217).
# OWNER_LANGUAGES=en
# OWNER_CURRENCY=USD
# Your Telegram user id (message @userinfobot), so the bot answers you; without any linked id
# the bot refuses everyone (link later: bin/dana users telegram add <user> <id>).
# ALLOWED_TELEGRAM_USER_IDS=
# Telegram chat for reminders, briefing, weekly review, digest
# TELEGRAM_CHAT_ID=
