# Your server and devices, for the Android build and android/bin/deploy-*.sh
# (docs/site.md). Plain KEY=value lines: sourced by bash, read by Gradle.

# Your Dana server: the apps' default server address, and where bin/deploy-app.sh publishes
SERVER_URL=https://dana.example.com
# DNS servers on your LAN the TV app asks first (comma-separated; empty: the system's)
LAN_DNS_SERVERS=
# The publish token, or a command that prints it (run only when publishing)
# APP_PUBLISH_TOKEN=
# APP_PUBLISH_TOKEN_CMD='pass show dana/app-publish-token'

# adb serials (a host:port is connected first)
TV_SERIAL=
KIOSK_SERIAL=
# The watch for bin/deploy-app.sh --watch-ip
WATCH_IP=
