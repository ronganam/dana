# server/bin/deploy's settings (docs/site.md, server/docs/operations.md "Deploying"): rename to
# deploy.env when it is filled in. Plain KEY=value lines, sourced by bash. bin/deploy <version>
# rolls out the published image of that release; it builds nothing.

# The published image (default ghcr.io/ronganam/dana, what .github/workflows/release.yml pushes).
# DANA_IMAGE=ghcr.io/ronganam/dana
# How long to wait for the release workflow to publish it, in seconds (default 1800).
# DANA_IMAGE_WAIT=1800

# How to run `dana` where the server runs, to learn the installed add-ons' workers
# (`dana addons workers --json`); each is pinned to its published image's tag. Empty: workers untouched.
# DANA_EXEC="kubectl -n dana exec deploy/dana -c dana --"
# DANA_EXEC="docker compose --project-directory /srv/dana exec -T dana"

# GitOps: the repository and values file whose `tag:` lines (and worker images,
# `image: "<published image>:<tag>"`) get the new release, for ArgoCD / Flux to roll out.
DANA_GITOPS_REPO=
DANA_GITOPS_BRANCH=main
DANA_GITOPS_VALUES=apps/dana/values.yaml

# Compose instead: the folder of the repository root's compose.yaml (its .env gets DANA_VERSION
# and each worker's <ADDON>_WORKER_TAG, then docker compose pull && up -d).
# DANA_COMPOSE_DIR=/srv/dana

# `bin/deploy --wait` (GitOps): where the pod runs.
DANA_K8S_NAMESPACE=dana
DANA_K8S_SELECTOR=app=dana
