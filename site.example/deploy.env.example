# server/bin/deploy's settings (docs/site.md): rename to deploy.env when it is filled in.
# Without deploy.env, pushing master runs the tests and deploys nothing. Plain KEY=value
# lines, sourced by bash.

# The image Dana is pushed as (tags "<VERSION>-<commit>[-a<site addons hash>]" and "latest").
DANA_IMAGE=registry.example.com/dana
# The bank-worker sidecar (the money addon's bank syncs). Empty: not built.
DANA_WORKER_IMAGE=registry.example.com/dana-bank-worker

# GitOps: the repository and values file whose `tag:` lines get the new release.
# Empty DANA_GITOPS_REPO: the images are pushed and you roll them out yourself.
DANA_GITOPS_REPO=
DANA_GITOPS_BRANCH=main
DANA_GITOPS_VALUES=apps/dana/values.yaml

# `bin/deploy --wait`: where the pod runs.
DANA_K8S_NAMESPACE=dana
DANA_K8S_SELECTOR=app=dana

# Site addon folders built into the image (":"-separated). Default: this site's addons/.
# DANA_IMAGE_ADDONS=
