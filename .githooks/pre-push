#!/usr/bin/env bash
# Test on this machine before pushing (docs: server/docs/operations.md, "Releasing").
#
# Pushing master/main runs the server's `bin/test --changed <remote> --quick` (only the scripts the
# pushed change touches, the slow ones left out; DANA_FULL_TESTS=1 runs everything) on a clean
# checkout of the pushed commit when it changes anything under server/ or examples/ besides docs; when it changes
# server/Dockerfile or server/requirements.lock also the image's `test` stage (the suite on
# the exact image), after bin/test, never at once. It deploys nothing: a release is a pushed
# tag v<version> (.github/workflows/release.yml publishes the image), then server/bin/deploy.
# Android changes are not tested here (./gradlew in android/; docs in android/AGENTS.md).
# A failure stops the push.
# Installed by: git config core.hooksPath .githooks     Skip it: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# git exports GIT_DIR and friends to hooks: the tests' own git commands would act on this
# repository instead of their own folders.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
  GIT_COMMON_DIR GIT_PREFIX GIT_NAMESPACE GIT_QUARANTINE_PATH

root="$PWD"
zero=0000000000000000000000000000000000000000
changed=""
tested=""
base=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/master|refs/heads/main) ;; *) continue ;; esac
  [ "$local_sha" = "$zero" ] && continue                      # deleting the branch
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    changed+=$'\n'"(everything)"
  else
    changed+=$'\n'"$(git diff --name-only "$remote_sha" "$local_sha")"
    base="$remote_sha"
  fi
  tested="$local_sha"
done
changed="$(printf '%s\n' "$changed" | sed '/^$/d')"
[ -z "$changed" ] && exit 0

# Here-strings, not pipes: with pipefail, `grep -q` exiting at its first match makes the writer
# die of SIGPIPE on a long list, and the whole test would read as "no match".
server_code="$(grep -E '^(server/|examples/|\(everything\))' <<< "$changed" | grep -vE '^(server/docs/.*|.*\.md)$' || true)"
if [ -z "$server_code" ]; then
  echo "pre-push: no server code changed, no server tests."
  exit 0
fi

# Test exactly the pushed commit, in a clean temporary checkout: the working tree may
# hold someone's unfinished work.
checkout="$(mktemp -d "${TMPDIR:-/tmp}/dana-prepush-XXXXXX")"
trap 'git -C "$root" worktree remove --force "$checkout" >/dev/null 2>&1 || rm -rf "$checkout"' EXIT
git worktree add --detach -q "$checkout" "$tested"
python="$root/server/.venv/bin/python"; [ -x "$python" ] || python=python3

args=()
if [ -z "${DANA_FULL_TESTS:-}" ] && [ -n "$base" ]; then args=(--changed "$base" --quick); fi
echo "pre-push: bin/test ${args[*]:-(everything)} on ${tested:0:7} (DANA_FULL_TESTS=1 for all; skip with --no-verify)"
(cd "$checkout/server" && "$python" bin/test "${args[@]}") || { echo "pre-push: tests failed; nothing pushed."; exit 1; }

if [ -n "${DANA_FULL_TESTS:-}" ] && grep -qE '^(server/Dockerfile|server/requirements\.(txt|lock)|\(everything\))$' <<< "$changed"; then
  echo "pre-push: the image changed: running the suite in the image's test stage"
  docker build --target test -q -t dana:test "$checkout/server" >/dev/null \
    || { echo "pre-push: the image's test stage failed (docker build --target test server); nothing pushed."; exit 1; }
fi

