<?xml version="1.0" encoding="utf-8"?>
<!-- The phone app: everything the kiosk and the TV don't have (call recordings,
     the watch bridge, the system assistant, the notification Inbox, pop-ups,
     direct push, widgets, in-app updates). docs/permissions.md lists why each
     permission is here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Coding-agent sessions as Android 16 Live Updates (push/AgentSessions.kt) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- In-app updates: lets the app hand the downloaded APK to the system installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- WorkManager runs long call-recording uploads as a foreground job -->
    <!-- Caller card: notice incoming / outgoing calls (callcard/CallerCard.kt). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application>
        <!-- The launcher entry and share target (the activity itself is in main). -->
        <activity android:name=".MainActivity" android:exported="true" tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- Share text, links and images from any app into a new chat -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Pairing: the QR code of the web Devices page holds dana://pair?server=…&code=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dana" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Urgent phone notifications → full-screen alert (direct push) -->
        <activity
            android:name=".NotificationAlertActivity"
            android:exported="false"
            android:theme="@style/Theme.Dana"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="io.github.ronganam.dana.alert"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- New suggestions pop up for review (direct push) -->
        <activity
            android:name=".SuggestionsPopupActivity"
            android:exported="false"
            android:theme="@style/Theme.Dana"
            android:showOnLockScreen="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.ronganam.dana.suggestions"
            android:windowSoftInputMode="adjustResize" />

        <!-- Alerts, suggestion pop-ups, reminders and web button presses arrive
             by direct push (push/PushPing), not as exported
             broadcasts any app could send. -->

        <!-- Restarts the call observer after a reboot or app update -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- "Hide" on a coding-agent session's live notification -->
        <receiver
            android:name=".push.AgentSessionReceiver"
            android:exported="false" />

        <!-- "Retry" on a failed call-recording upload notification -->
        <receiver
            android:name=".data.sync.CallUploadReceiver"
            android:exported="false" />

        <!-- Dana as the device's assistant app (power-button sheet) -->
        <service
            android:name=".DanaVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
        </service>

        <service
            android:name=".DanaVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:process=":session" />

        <service
            android:name=".DanaRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <service
            android:name=".CallRecordingObserverService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors the call recordings directory for new recordings and uploads them to Dana" />
        </service>

        <service
            android:name=".data.wear.WearMessageListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.BIND_LISTENER"
                    tools:ignore="WearableBindListener" />
            </intent-filter>
        </service>

        <!-- Phone notifications → Dana's Inbox (needs "Notification access") -->
        <service
            android:name=".data.notifications.DanaNotificationListener"
            android:exported="true"
            android:label="@string/label_notification_inbox"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Direct push from the server: FCM wake-up pings in a build with your own
             Firebase project (push/PhoneEvents). -->
        <service
            android:name=".push.DanaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Direct push from the server through a UnifiedPush distributor (ntfy): new
             endpoints and wake-up pings (push/PushSetup, push/PhoneEvents). -->
        <service
            android:name=".push.DanaUnifiedPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- Caller card: floating card + watch card when someone calls. -->
        <receiver
            android:name=".callcard.CallerCardReceiver"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Ask Dana widget / launcher shortcut trampoline. -->
        <activity
            android:name=".AskDanaActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Home-screen widgets (widgets/Widgets.kt). -->
        <receiver android:name=".widgets.AskWidgetReceiver" android:exported="true" android:label="@string/widget_ask">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_ask" />
        </receiver>
        <receiver android:name=".widgets.TodayWidgetReceiver" android:exported="true" android:label="@string/widget_today">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today" />
        </receiver>
        <receiver android:name=".widgets.WaitingWidgetReceiver" android:exported="true" android:label="@string/widget_waiting">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_waiting" />
        </receiver>
        <receiver android:name=".widgets.PeopleWidgetReceiver" android:exported="true" android:label="@string/widget_people">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_people" />
        </receiver>
        <receiver android:name=".widgets.InboxWidgetReceiver" android:exported="true" android:label="@string/widget_inbox">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_inbox" />
        </receiver>
        <!-- The Shopping widget's +: quick add over the home screen (widgets/ShoppingQuickAddActivity.kt). -->
        <activity
            android:name=".widgets.ShoppingQuickAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Dana.VoiceSession"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
        <receiver android:name=".widgets.ShoppingWidgetReceiver" android:exported="true" android:label="@string/widget_shopping">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_shopping" />
        </receiver>
    </application>
</manifest>
