<?xml version="1.0" encoding="utf-8"?>
<!-- What every flavor (phone, kiosk, tv) has. Phone-only permissions and
     components are in src/phone/AndroidManifest.xml; the kiosk and the TV add
     their own in theirs. docs/permissions.md lists every permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Display over other apps": lets the suggestion / urgent alert screens open from the background -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Live push-to-talk transcription binds the system speech recognizer. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- App names for the notification Inbox (package visibility hides
             other apps' labels otherwise). Launcher apps cover the senders. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".DanaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dana"
        tools:targetApi="36">

        <!-- WorkManager starts on demand from DanaApp (Configuration.Provider),
             so it also works in the assistant sheet's :session process. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- The phone app's main screen. Only the phone manifest makes it
             launchable (and a share target); kiosk / TV code links to it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dana"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ReminderActivity"
            android:exported="false"
            android:theme="@style/Theme.Dana"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showForAllUsers="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".CallDebriefActivity"
            android:exported="false"
            android:theme="@style/Theme.Dana"
            android:launchMode="singleTop"
            android:taskAffinity="io.github.ronganam.dana.debrief"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ShortCallActivity"
            android:exported="false"
            android:theme="@style/Theme.Dana.VoiceSession"
            android:taskAffinity="io.github.ronganam.dana.shortcall"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <!-- Serves downloaded update APKs to the system package installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
